load("//build:checks.bzl", "host_test")
load("//packages:package.bzl", "package_store")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "BUILD.bazel",
    "MODULE.bazel",
    "LICENSE",
])

filegroup(
    name = "artifacts",
    srcs = [
        "//apps/gxwi-disk-manager",
        "//apps/gxwi-event-viewer",
        "//apps/gxwi-feature-manager",
        "//apps/gxwi-file-dialog",
        "//apps/gxwi-file-explorer",
        "//apps/gxwi-my-settings",
        "//apps/gxwi-network-manager",
        "//apps/gxwi-package-manager",
        "//apps/gxwi-principals-manager",
        "//apps/gxwi-registry-editor",
        "//apps/gxwi-sd-editor",
        "//apps/gxwi-security-policy",
        "//apps/gxwi-services-manager",
        "//apps/gxwi-system-settings",
        "//apps/gxwi-task-manager",
        "//apps/gxwi-terminal",
        "//apps/gxwi-text-editor",
        "//apps/gxwi-upgrade-peios",
    ],
)

filegroup(
    name = "application-sources",
    srcs = [
        "//apps/gxwi-disk-manager:sources",
        "//apps/gxwi-event-viewer:sources",
        "//apps/gxwi-feature-manager:sources",
        "//apps/gxwi-file-dialog:sources",
        "//apps/gxwi-file-explorer:sources",
        "//apps/gxwi-my-settings:sources",
        "//apps/gxwi-network-manager:sources",
        "//apps/gxwi-package-manager:sources",
        "//apps/gxwi-principals-manager:sources",
        "//apps/gxwi-registry-editor:sources",
        "//apps/gxwi-sd-editor:sources",
        "//apps/gxwi-security-policy:sources",
        "//apps/gxwi-services-manager:sources",
        "//apps/gxwi-system-settings:sources",
        "//apps/gxwi-task-manager:sources",
        "//apps/gxwi-terminal:sources",
        "//apps/gxwi-text-editor:sources",
        "//apps/gxwi-upgrade-peios:sources",
        "//crates/gxwi-fs:sources",
        "//crates/gxwi-process:sources",
    ],
)

filegroup(
    name = "build-files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//apps/gxwi-disk-manager:BUILD.bazel",
        "//apps/gxwi-event-viewer:BUILD.bazel",
        "//apps/gxwi-feature-manager:BUILD.bazel",
        "//apps/gxwi-file-dialog:BUILD.bazel",
        "//apps/gxwi-file-explorer:BUILD.bazel",
        "//apps/gxwi-my-settings:BUILD.bazel",
        "//apps/gxwi-network-manager:BUILD.bazel",
        "//apps/gxwi-package-manager:BUILD.bazel",
        "//apps/gxwi-principals-manager:BUILD.bazel",
        "//apps/gxwi-registry-editor:BUILD.bazel",
        "//apps/gxwi-sd-editor:BUILD.bazel",
        "//apps/gxwi-security-policy:BUILD.bazel",
        "//apps/gxwi-services-manager:BUILD.bazel",
        "//apps/gxwi-system-settings:BUILD.bazel",
        "//apps/gxwi-task-manager:BUILD.bazel",
        "//apps/gxwi-terminal:BUILD.bazel",
        "//apps/gxwi-text-editor:BUILD.bazel",
        "//apps/gxwi-upgrade-peios:BUILD.bazel",
        "//build:BUILD.bazel",
        "//build:starlark",
        "//crates/gxwi-fs:BUILD.bazel",
        "//crates/gxwi-process:BUILD.bazel",
        "//packages:build-files",
        "//tools:BUILD.bazel",
        "//vendor/kernel:BUILD.bazel",
        "//vendor/kernel/peios/rust/ntfe:BUILD.bazel",
        "//vendor/kernel/peios/rust/peios-uapi:BUILD.bazel",
        "//vendor/kernel/peios/rust/pnp-core:BUILD.bazel",
        "//vendor/ppk:BUILD.bazel",
    ],
)

genrule(
    name = "build-format-check",
    srcs = [":build-files"],
    outs = ["build-format-check.stamp"],
    cmd = "$(execpath @buildifier//file) -mode=check -lint=warn $(execpaths :build-files) && touch $@",
    tools = ["@buildifier//file"],
)

host_test(
    name = "vendor-test",
    size = "small",
    command = "exec python3 tools/test-bazel-vendor.py",
    data = [
        "//tools:bazel-vendor.py",
        "//tools:test-bazel-vendor.py",
    ],
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        ":application-sources",
        "//packages:definitions",
        "//vendor/kernel:sources",
    ] + glob([
        "docs/man/*",
        "docs/*.regman",
        "third-party/**",
    ]),
)

filegroup(
    name = "package-sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.*/**",
            "**/.*",
            "bazel-*/**",
            "target/**",
            "docs/learn/dist/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/node_modules/**",
        ],
    ) + glob([
        ".github/**",
    ]) + [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".gitattributes",
        ".gitignore",
        ":package-data",
        "//build:sources",
        "//packages:sources",
        "//tools:sources",
        "//vendor/ppk:sources",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)

host_test(
    name = "kernel-vendor-test",
    size = "small",
    command = "exec python3 tools/check-kernel-vendor.py",
    data = [
        "//tools:check-kernel-vendor.py",
        "//vendor/kernel:sources",
    ],
)
