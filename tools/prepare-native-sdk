#!/bin/sh
# Declare the installed native Peios SDK without mutating the host installation.
set -eu
sdk=${1:?usage: prepare-native-sdk ABSOLUTE_OUTPUT}
case "$sdk" in /*) ;; *)
    echo "SDK output must be absolute" >&2
    exit 1
    ;;
esac
[ ! -e "$sdk" ] || {
    echo "SDK output already exists: $sdk" >&2
    exit 1
}
pkg-config --atleast-version=0.5.10 peios || {
    echo "GXWI Essentials requires libpeios 0.5.10 or newer (NULL ACL support)." >&2
    exit 1
}
libdir=$(pkg-config --variable=libdir peios)
includedir=$(pkg-config --variable=includedir peios)
readelf -dW "$libdir/libpeios.so" | grep -E '\(SONAME\).*\[libpeios\.so\.0\]' >/dev/null
pkg-config --atleast-version=0.0.7 gxwi
gxwi_libdir=$(pkg-config --variable=libdir gxwi)
gxwi_includedir=$(pkg-config --variable=includedir gxwi)
[ -f "$gxwi_includedir/peios/gxwi.h" ] || {
    echo "Missing GXWI SDK header: $gxwi_includedir/peios/gxwi.h" >&2
    exit 1
}
readelf -dW "$gxwi_libdir/libgxwi.so" | grep -E '\(SONAME\).*\[libgxwi\.so\.1\]' >/dev/null
mkdir -p "$sdk/include/peios" "$sdk/lib"
ln -s "$includedir/peios.h" "$sdk/include/peios.h"
# The two development packages may use different installation prefixes.
# Keep the directory local so the GXWI header always comes from its package.
for header in "$includedir"/peios/*; do
    [ -e "$header" ] || [ -L "$header" ] || continue
    name=${header##*/}
    [ "$name" != gxwi.h ] || continue
    ln -s "$header" "$sdk/include/peios/$name"
done
ln -s "$gxwi_includedir/peios/gxwi.h" "$sdk/include/peios/gxwi.h"
ln -s /usr/include/pkm "$sdk/include/pkm"
ln -s "$libdir/libpeios.so.0" "$sdk/lib/libpeios.so.0"
ln -s "$gxwi_libdir/libgxwi.so.1" "$sdk/lib/libgxwi.so.1"
