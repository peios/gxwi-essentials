load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:checks.bzl", "host_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "BUILD.bazel",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "target/**",
        ],
    ),
)

rust_binary(
    name = "gxwi-terminal",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"] + glob(
        [
            "src/**/*.css",
            "page/**",
        ],
        allow_empty = True,
    ),
    crate_features = [],
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = all_crate_deps(normal = True) + [],
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":gxwi-terminal",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

host_test(
    name = "browser-input-tests",
    size = "small",
    command = "exec node --test apps/gxwi-terminal/page/input.test.mjs",
    data = [
        "page/input.mjs",
        "page/input.test.mjs",
    ],
    target_compatible_with = select({
        "//build:native": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
