# The machine's settings.
def build gxwi_system_settings() {
    = rust.bin(crates(), "gxwi-system-settings")
}

# The task manager.
def build gxwi_task_manager() {
    = rust.bin(crates(), "gxwi-task-manager")
}

# The terminal.
def build gxwi_terminal() {
    = rust.bin(crates(), "gxwi-terminal")
